---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, RESEARCH_INTERESTS, AWARDS } from '../data/siteConfig';

const universityName = 'Pukyong National University';
---

<BaseLayout>
  <div class="molecule-decorations" aria-hidden="true">
    <svg class="floating-molecule molecule-ring" viewBox="0 0 180 180" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false">
      <path d="M90 30 142 60V120L90 150 38 120V60Z" />
      <path d="M90 42 130 65M130 115 90 138M50 113V67" />
    </svg>
    <svg class="floating-molecule molecule-water" viewBox="0 0 180 180" fill="none" stroke="currentColor" stroke-width="2" focusable="false">
      <path d="M40 130 90 90 140 130" />
      <g fill="var(--bg)"><circle cx="90" cy="90" r="15" /><circle cx="40" cy="130" r="10" /><circle cx="140" cy="130" r="10" /></g>
      <g fill="currentColor" stroke="none" text-anchor="middle" dominant-baseline="central" font-family="sans-serif" font-size="11"><text x="90" y="90">O</text><text x="40" y="130">H</text><text x="140" y="130">H</text></g>
    </svg>
    <svg class="floating-molecule molecule-chain" viewBox="0 0 180 180" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" focusable="false">
      <path d="M35 112 90 80 145 112" />
      <g fill="var(--bg)"><circle cx="35" cy="112" r="8" /><circle cx="90" cy="80" r="8" /><circle cx="145" cy="112" r="12" /></g>
      <text x="145" y="112" fill="currentColor" stroke="none" text-anchor="middle" dominant-baseline="central" font-family="sans-serif" font-size="12">O</text>
    </svg>
  </div>
  <div class="home">
    <div class="author-avatar-wrapper">
      <div class="author-avatar">
        <img src="/assets/avatar.png" alt="Molecular capsule illustration used as Sargol Mazraedoost’s avatar" width="155" height="155" />
      </div>
      <h1><strong>{SITE.author}, Ph.D.</strong></h1>
      <p class="name-translations"><span lang="fa" dir="rtl">سارگل مزرعه‌دوست</span> · <span lang="ko">사르골 마즈라에두스트</span></p>
      <p class="profile-tagline">{SITE.tagline}</p>
      <div class="post-content">
        {SITE.bio.map((paragraph) => (
          <p>{paragraph.split(universityName).map((part, index) => (
            <>{index > 0 && <a href={SITE.university} target="_blank" rel="noopener noreferrer">{universityName}</a>}{part}</>
          ))}</p>
        ))}
      </div>
      <p><a href="/cv">Academic CV →</a></p>
    </div>

    <section class="prose" aria-labelledby="research-heading">
      <h2 id="research-heading">Research Interests</h2>
      <ul>{RESEARCH_INTERESTS.map((interest) => <li>{interest}</li>)}</ul>
      <p><a href="/projects">Explore my research →</a></p>
    </section>

    <section aria-labelledby="highlight-heading">
      <h2 id="highlight-heading">Research Highlight</h2>
      <figure class="research-highlight">
        <a href="https://doi.org/10.1021/acs.jcim.5c00167" target="_blank" rel="noopener noreferrer" aria-label="Read the JCIM cover article">
          <img src="/assets/jcim-cover.jpg" alt="Journal of Chemical Information and Modeling, volume 65, issue 7, front cover featuring a molecular hourglass" width="600" height="797" loading="lazy" />
        </a>
        <figcaption>
          <p>Our work on predicting retention time from molecular SMILES using a hybrid Transformer–LSTM model was featured on the front cover of the <em>Journal of Chemical Information and Modeling</em>, volume 65, issue 7 (2025).</p>
          <p><a href="https://doi.org/10.1021/acs.jcim.5c00167" target="_blank" rel="noopener noreferrer">Read the paper ↗</a></p>
        </figcaption>
      </figure>
    </section>

    <section class="prose" aria-labelledby="awards-heading">
      <h2 id="awards-heading">Awards</h2>
      <ul>{AWARDS.map((award) => <li>{award.split(universityName).map((part, index) => (
        <>{index > 0 && <a href={SITE.university} target="_blank" rel="noopener noreferrer">{universityName}</a>}{part}</>
      ))}</li>)}</ul>
    </section>

    <section aria-labelledby="contact-heading">
      <h2 id="contact-heading">Contact</h2>
      <p>Email me at <a class="email-link" href={`mailto:${SITE.email}`}>{SITE.email}</a>.</p>
      <div class="profile-links social-icons-container">
        <a href={`mailto:${SITE.email}`} aria-label="Email Sargol Mazraedoost" title="Email"><i class="fas fa-envelope" aria-hidden="true"></i></a>
        <a href={SITE.scholar} target="_blank" rel="noopener noreferrer" aria-label="Google Scholar" title="Google Scholar"><i class="fas fa-graduation-cap" aria-hidden="true"></i></a>
        <a href={SITE.researchgate} target="_blank" rel="noopener noreferrer" aria-label="ResearchGate" title="ResearchGate"><i class="fa-brands fa-researchgate" aria-hidden="true"></i></a>
        <a href={SITE.orcid} target="_blank" rel="noopener noreferrer" aria-label="ORCID" title="ORCID"><i class="fa-brands fa-orcid" aria-hidden="true"></i></a>
        <a href={SITE.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub" title="GitHub"><i class="fa-brands fa-github" aria-hidden="true"></i></a>
        <a href={SITE.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" title="LinkedIn"><i class="fa-brands fa-linkedin" aria-hidden="true"></i></a>
      </div>
    </section>
  </div>
</BaseLayout>
